# npm start reads .env; process environment variables take precedence.
# Start cloudflared first, then replace APP_ORIGIN with THIS session's URL.
# Node listens on loopback HTTP; Cloudflare supplies public HTTPS.
# No public IP, router forwarding, TLS key, ACME account or mandatory email gate.
APP_PROFILE=desktop
APP_ORIGIN=https://REPLACE_WITH_CURRENT_TUNNEL.trycloudflare.com
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_ACCESS=quick-tunnel
SESSION_COOKIE_SECURE=true
TRUST_PROXY=loopback
SQLITE_PATH=./data/twelve-janggi.sqlite
SESSION_SECRET=REPLACE_WITH_RANDOM_DESKTOP_SECRET
BATCH_CONCURRENCY=2
MODEL_MOVE_MS=60000
INTERACTIVE_MOVE_MS=60000

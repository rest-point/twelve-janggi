# npm start reads .env; process environment variables take precedence.
APP_PROFILE=laptop
APP_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_ACCESS=local
SESSION_COOKIE_SECURE=false
TRUST_PROXY=none
SQLITE_PATH=./data/laptop-dev.sqlite
SESSION_SECRET=REPLACE_WITH_RANDOM_LOCAL_SECRET
BATCH_CONCURRENCY=2
MODEL_MOVE_MS=60000
INTERACTIVE_MOVE_MS=60000
